# Configuration de l'application
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Configuration de la base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost/minibus_db

# Configuration Wave Payment
WAVE_API_KEY=
WAVE_MERCHANT_KEY=
WAVE_API_URL=https://api.wave.com/v1

# Configuration Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay

# Configuration MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com

# Provider utilisé pour les nouvelles initiations de paiement (paystack | jeko).
# Les webhooks/callbacks des deux providers restent actifs quel que soit le choix.
PAYMENT_PROVIDER=paystack

# Configuration Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_URL=https://api.paystack.co
# Domaine des adresses techniques client-{id}@... (utilisateurs sans email)
PAYMENT_EMAIL_DOMAIN=jelani.tech

# Configuration JEKO (requis si PAYMENT_PROVIDER=jeko)
# Credentials : Cockpit JEKO > Settings > API & Webhooks
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
JEKO_URL=https://api.jeko.africa/partner_api
# Base publique de l'API pour les URLs de retour JEKO (successUrl/errorUrl)
PAYMENT_PUBLIC_BASE_URL=

# Annulation possible jusqu'à N minutes avant le départ du trip
BOOKING_CANCELLATION_CUTOFF_MINUTES=60

# Deep link mobile (ex: jelani://payment-callback) vers lequel la page
# /api/payments/callback redirige a la fin du checkout. Jamais envoye au provider
# (JEKO n'accepte que des URLs http(s)). Nécessite que le scheme soit déclaré
# côté app. Vide = page HTML de callback seule.
BOOKING_DEEPLINK_CALLBACK=

# ── Wallet client ────────────────────────────────────────────────────────────
# Porte-monnaie fermé : dépôt mobile money, paiement de réservation depuis le
# solde, recrédit à l'annulation. Aucun retrait.
#
# Déploiement progressif : le code est livré inerte (WALLET_ENABLED=false) et
# chaque étape s'ouvre séparément.
#   1. migrations appliquées, tout à false        -> rien ne change
#   2. WALLET_ENABLED=true, TOPUP/PAYMENT=false   -> lecture seule (solde à 0)
#   3. + WALLET_TOPUP_ENABLED=true                -> rechargement (plafonds bas d'abord)
#   4. + WALLET_PAYMENT_ENABLED=true              -> paiement depuis le solde
#   5. + WALLET_REFUND_TO_WALLET=true             -> remboursements en wallet
# Jusqu'à l'étape 4, WALLET_ENABLED=false suffit à revenir en arrière. Après
# l'étape 5, un retour arrière laisse des soldes réels : les endpoints de
# lecture doivent rester ouverts pour que les clients voient leur solde.
WALLET_ENABLED=false
WALLET_TOPUP_ENABLED=true
WALLET_PAYMENT_ENABLED=true
WALLET_REFUND_TO_WALLET=false

# Plafonds, en francs XOF entiers (pas de sous-unité pour le franc CFA)
WALLET_MIN_TOPUP_XOF=500
WALLET_MAX_TOPUP_XOF=200000
WALLET_MAX_BALANCE_XOF=500000
WALLET_DAILY_TOPUP_LIMIT_XOF=300000

# Limitation de débit sur POST /api/wallet/topups (par client)
WALLET_TOPUP_RATE_LIMIT=10
WALLET_TOPUP_RATE_WINDOW_MINUTES=10
# Fenêtre de réutilisation d'un rechargement 'pending' identique
WALLET_TOPUP_REUSE_MINUTES=15

# Configuration Brevo (Email transactional)
BREVO_API_KEY=
BREVO_SENDER_NAME=Jelani
BREVO_SENDER_EMAIL=noreply@jelani.tech
