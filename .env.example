# Configuration de l'application
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Configuration de la base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost/minibus_db

# Configuration Wave Payment
WAVE_API_KEY=
WAVE_MERCHANT_KEY=
WAVE_API_URL=https://api.wave.com/v1

# Configuration Orange Money
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay

# Configuration MTN Mobile Money
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com

# Provider utilisé pour les nouvelles initiations de paiement (paystack | jeko).
# Les webhooks/callbacks des deux providers restent actifs quel que soit le choix.
PAYMENT_PROVIDER=paystack

# Configuration Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_URL=https://api.paystack.co
# Domaine des adresses techniques client-{id}@... (utilisateurs sans email)
PAYMENT_EMAIL_DOMAIN=jelani.tech

# Configuration JEKO (requis si PAYMENT_PROVIDER=jeko)
# Credentials : Cockpit JEKO > Settings > API & Webhooks
JEKO_API_KEY=
JEKO_API_KEY_ID=
JEKO_STORE_ID=
JEKO_WEBHOOK_SECRET=
JEKO_URL=https://api.jeko.africa/partner_api
# Base publique de l'API pour les URLs de retour JEKO (successUrl/errorUrl)
PAYMENT_PUBLIC_BASE_URL=

# Configuration Brevo (Email transactional)
BREVO_API_KEY=
BREVO_SENDER_NAME=Jelani
BREVO_SENDER_EMAIL=noreply@jelani.tech
