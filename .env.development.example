# Local development environment.
# Copy this file to .env.development if you run the Flask backend directly
# on your machine. Docker Compose injects equivalent values automatically.

APP_ENV=development
FLASK_DEBUG=1
FLASK_APP=app.py

SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Local PostgreSQL mirror started by docker-compose.local.yml.
DATABASE_URL=postgresql://user:password@localhost:5432/minibus_db

# Supabase-aligned local schema. Keep legacy migrations disabled in dev.
AUTO_UPGRADE_DB=false
LEGACY_SCHEMA_BOOTSTRAP=false

WAVE_API_KEY=
WAVE_MERCHANT_KEY=
WAVE_API_URL=https://api.wave.com/v1

ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay

MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
