meta {
  name: Initiate Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/payments/initiate
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "booking_id": "decc18a0-6c31-4a35-ba10-1438ff3b4c3b",
    "payment_email":"ruthboua@gmail.com"
  }
}

docs {
  # Initiate Payment
  
  Initie un paiement pour une réservation.
  Nécessite un token JWT valide.
  
  Méthodes de paiement disponibles:
  - wave
  - orange_money
  - mtn_momo
  
  Remplacez `booking_id` par l'ID d'une réservation en attente.
}
